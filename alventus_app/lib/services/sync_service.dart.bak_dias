  // ============ OPERACIONES DE SINCRONIZACIÓN INDIVIDUALES ============

  /// Sincroniza una creación de tarea o de contacto de referencia
  Future<bool> _syncCreate(String model, Map<String, dynamic> change) async {
    if (model == 'project.task') {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      try {
        final data = jsonDecode(dataStr) as Map<String, dynamic>;
        final projectId =
            int.tryParse(data['project_id']?.toString() ?? '') ?? 0;
        final name = data['name']?.toString() ?? '';
        final description = data['description']?.toString();
        final stageName = data['stage_name']?.toString();

        print('🔄 _syncCreate: Creando tarea "$name" en proyecto $projectId (etapa: $stageName)');

        if (projectId == 0 || name.isEmpty) return false;

        final result = await _odooService.createTaskInStage(
          projectId: projectId,
          name: name,
          description: description,
          stageName: stageName,
        );

        print('🔄 _syncCreate: Resultado = ${result['success']}');
        return result['success'] == true;
      } catch (e) {
        print('❌ Error en _syncCreate: $e');
        return false;
      }
    }

    if (model == 'reference_contact') {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      try {
        final data = jsonDecode(dataStr) as Map<String, dynamic>;
        final projectId = int.tryParse(data['project_id']?.toString() ?? '') ?? 0;
        final name = data['name']?.toString() ?? '';
        final phone = data['phone']?.toString();
        final email = data['email']?.toString();
        final tempId = change['record_id'] as int?;

        print('🔄 _syncCreate: Creando contacto "$name" en proyecto $projectId');

        if (projectId == 0 || name.isEmpty) return false;

        final result = await _odooService.createAndLinkReferenceContact(
          projectId: projectId,
          name: name,
          phone: (phone != null && phone.isNotEmpty) ? phone : null,
          email: (email != null && email.isNotEmpty) ? email : null,
        );

        if (result['success'] == true && tempId != null) {
          // Borra el contacto temporal local; la próxima sincronización
          // de contactos traerá el real con su id definitivo.
          await _localDb.deleteReferenceContactLocal(tempId);
        }

        print('🔄 _syncCreate: Resultado = ${result['success']}');
        return result['success'] == true;
      } catch (e) {
        print('❌ Error en _syncCreate (contacto): $e');
        return false;
      }
    }

    return false;
  }

  /// Sincroniza una actualización de tarea
  Future<bool> _syncUpdate(String model, int recordId, Map<String, dynamic> change) async {
    if (model == 'project.task') {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      try {
        final data = jsonDecode(dataStr) as Map<String, dynamic>;

        print('🔄 _syncUpdate: Actualizando tarea $recordId');
        print('🔄 _syncUpdate: name="${data["name"]}", description="${data["description"]}"');

          final result = await _odooService.updateTask(
          taskId: recordId,
          name: data['name']?.toString(),
          description: data['description']?.toString(),
        );

        print('🔄 _syncUpdate: Resultado = ${result['success']}');
        return result['success'] == true;
      } catch (e) {
        print('❌ Error en _syncUpdate: $e');
        return false;
      }
    }
    return false;
  }

  /// Sincroniza un borrado de tarea
  Future<bool> _syncDelete(String model, int recordId) async {
    if (model == 'project.task') {
      print('🔄 _syncDelete: Borrando tarea $recordId');
      final result = await _odooService.deleteTask(recordId);
      print('🔄 _syncDelete: Resultado = ${result['success']}');
      return result['success'] == true;
    }
    return false;
  }

  /// Sincroniza la subida de un archivo offline: adjunto de tarea,
  /// archivo de ruta, documento de proyecto o foto de grupo, según el
  /// "model" del cambio pendiente.
  Future<bool> _syncUpload(String model, Map<String, dynamic> change) async {
    switch (model) {
      case 'ir.attachment':
        return _syncUploadTaskAttachment(change);
      case 'route_file':
        return _syncUploadRouteFile(change);
      case 'ir.attachment.project':
        return _syncUploadProjectDocument(change);
      case 'project.photo':
        return _syncUploadProjectPhoto(change);
      default:
        return false;
    }
  }

  Future<bool> _syncUploadTaskAttachment(Map<String, dynamic> change) async {
    try {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      final data = jsonDecode(dataStr) as Map<String, dynamic>;
      final taskId = int.tryParse(data['task_id']?.toString() ?? '') ?? 0;
      final fileName = data['file_name']?.toString() ?? '';
      final filePath = data['file_path']?.toString() ?? '';
      final tempAttachmentId = change['record_id'] as int?;

      print('🔄 _syncUpload: Subiendo adjunto "$fileName" a tarea $taskId');

      if (taskId == 0 || fileName.isEmpty || filePath.isEmpty) return false;

      final file = File(filePath);
      if (!await file.exists()) {
        print('❌ El archivo local no existe: $filePath');
        return false;
      }

      final result = await _odooService.uploadAttachment(
        taskId: taskId,
        fileName: fileName,
        file: file,
      );

      if (result['success'] == true) {
        print('✅ Adjunto subido correctamente a Odoo');

        if (tempAttachmentId != null) {
          final db = await _localDb.database;
          await db.delete('attachments', where: 'id = ?', whereArgs: [tempAttachmentId]);
        }

        try {
          await file.delete();
        } catch (_) {}

        await syncAttachments(taskId);
        return true;
      }

      return false;
    } catch (e) {
      print('❌ Error al subir adjunto: $e');
      return false;
    }
  }

  Future<bool> _syncUploadRouteFile(Map<String, dynamic> change) async {
    try {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      final data = jsonDecode(dataStr) as Map<String, dynamic>;
      final projectId = int.tryParse(data['project_id']?.toString() ?? '') ?? 0;
      final fileName = data['file_name']?.toString() ?? '';
      final filePath = data['file_path']?.toString() ?? '';
      final description = data['description']?.toString();
      final tempId = change['record_id'] as int?;

      print('🔄 _syncUpload: Subiendo archivo de ruta "$fileName" al proyecto $projectId');

      if (projectId == 0 || fileName.isEmpty || filePath.isEmpty) return false;

      final file = File(filePath);
      if (!await file.exists()) return false;

      final result = await _odooService.uploadRouteFile(
        projectId: projectId,
        fileName: fileName,
        file: file,
        description: (description != null && description.isNotEmpty) ? description : null,
      );

      if (result['success'] == true) {
        if (tempId != null) await _localDb.deleteRouteFileLocal(tempId);
        try {
          await file.delete();
        } catch (_) {}
        await syncRouteFiles(projectId);
        return true;
      }
      return false;
    } catch (e) {
      print('❌ Error al subir archivo de ruta: $e');
      return false;
    }
  }

  Future<bool> _syncUploadProjectDocument(Map<String, dynamic> change) async {
    try {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      final data = jsonDecode(dataStr) as Map<String, dynamic>;
      final projectId = int.tryParse(data['project_id']?.toString() ?? '') ?? 0;
      final fileName = data['file_name']?.toString() ?? '';
      final filePath = data['file_path']?.toString() ?? '';
      final tempId = change['record_id'] as int?;

      print('🔄 _syncUpload: Subiendo documento "$fileName" al proyecto $projectId');

      if (projectId == 0 || fileName.isEmpty || filePath.isEmpty) return false;

      final file = File(filePath);
      if (!await file.exists()) return false;

      final result = await _odooService.uploadProjectAttachment(
        projectId: projectId,
        fileName: fileName,
        file: file,
      );

      if (result['success'] == true) {
        if (tempId != null) await _localDb.deleteProjectDocumentLocal(tempId);
        try {
          await file.delete();
        } catch (_) {}
        await syncProjectDocuments(projectId);
        return true;
      }
      return false;
    } catch (e) {
      print('❌ Error al subir documento: $e');
      return false;
    }
  }

  Future<bool> _syncUploadProjectPhoto(Map<String, dynamic> change) async {
    try {
      final dataStr = change['data'] as String?;
      if (dataStr == null) return false;

      final data = jsonDecode(dataStr) as Map<String, dynamic>;
      final projectId = int.tryParse(data['project_id']?.toString() ?? '') ?? 0;
      final fileName = data['file_name']?.toString() ?? '';
      final filePath = data['file_path']?.toString() ?? '';
      final tempId = change['record_id'] as int?;

      print('🔄 _syncUpload: Subiendo foto "$fileName" al proyecto $projectId');

      if (projectId == 0 || fileName.isEmpty || filePath.isEmpty) return false;

      final file = File(filePath);
      if (!await file.exists()) return false;

      final result = await _odooService.uploadProjectPhoto(
        projectId: projectId,
        fileName: fileName,
        file: file,
      );

      if (result['success'] == true) {
        if (tempId != null) await _localDb.deleteProjectPhotoLocal(tempId);
        try {
          await file.delete();
        } catch (_) {}
        await syncProjectPhotos(projectId);
        return true;
      }
      return false;
    } catch (e) {
      print('❌ Error al subir foto: $e');
      return false;
    }
  }

  // ============ SINCRONIZACIÓN COMPLETA ============

  /// Sincronización completa: envía cambios pendientes y descarga datos actualizados
  Future<void> fullSync() async {
    if (_isSyncing) {
      print('⚠️ fullSync: Ya hay una sincronización en curso');
      return;
    }

    _isSyncing = true;

    try {
      final hasConnection = await checkConnectivity();

      if (!hasConnection) {
        print('📡 Sin conexión. Usando datos locales.');
        return;
      }

      print('🔄 ===== Iniciando sincronización completa =====');

      // 1. PRIMERO: enviar cambios pendientes a Odoo
      await _doSyncPendingChanges();

      // 2. Descargar proyectos actualizados
      await syncProjects();

      // 3. Descargar tareas de cada proyecto
      final projects = await _localDb.getProjects();
      for (final project in projects) {
        final projectId = project['id'] as int;
        await syncTasks(projectId);
      }

      print('✅ ===== Sincronización completa finalizada =====');
    } catch (e) {
      print('❌ Error en sincronización completa: $e');
    } finally {
      _isSyncing = false;
    }
  }

  /// Limpia los recursos
  void dispose() {
    _connectivitySubscription?.cancel();
  }
}